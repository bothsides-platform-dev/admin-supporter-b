# Shared Postgres (same DB as main app)
DATABASE_URL=postgres://supporter_b:supporter_b@localhost:5432/supporter_b

# Auth.js — Google OAuth
AUTH_SECRET=                    # openssl rand -base64 32
AUTH_GOOGLE_ID=                 # Google Cloud Console OAuth 클라이언트 ID
AUTH_GOOGLE_SECRET=             # Google Cloud Console OAuth 클라이언트 시크릿

# Resend (workspace approve/reject emails)
RESEND_API_KEY=
RESEND_FROM=send@support-b.com

# Main app URL — used in approval/rejection email links sent to users
# Must point to the MAIN app, NOT this admin app
PUBLIC_APP_URL=https://support-b.com

# This admin app's own origin
NEXT_PUBLIC_BASE_URL=https://admin.support-b.com

# Auth.js host trust — required in production behind a proxy (e.g. nginx)
# AUTH_URL pins the canonical callback origin so the OAuth round-trip is stable.
# AUTH_TRUST_HOST is a belt-and-suspenders fallback (trustHost:true is also set
# in auth.ts, so either alone is sufficient for trust, but both is safest).
AUTH_URL=https://admin.support-b.com
AUTH_TRUST_HOST=true

# Admin access control — allowed admin accounts live in the shared DB table
# `admin_users` (managed at /admins), NOT in env. Every admin also needs TOTP
# (authenticator app) as a second factor.
# AES-256-GCM key for TOTP secrets at rest. openssl rand -base64 32
# Losing it forces every admin to re-enroll 2FA — keep a copy outside the server.
ADMIN_TOTP_ENCRYPTION_KEY=

# 핵심 지표(/metrics)에서 내부 직원 계정으로 보고 뺄 이메일 도메인 (선택, 쉼표 구분).
# 비워 두면 도메인 기준 제외는 하지 않는다. docs/METRICS.md 참조.
METRICS_EXCLUDED_EMAIL_DOMAINS=

# 시스템 관측 (/observability) — docs/OBSERVABILITY.md
# Alloy와 같은 환경 이름. 서비스 키/토큰에 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
OBSERVABILITY_ENVIRONMENT=production
# Cloud portal의 Prometheus query URL (보통 /api/prom으로 끝남) / instance ID
GRAFANA_METRICS_QUERY_URL=
GRAFANA_METRICS_USER=
# Cloud portal의 Loki base URL (/loki/api/v1/push를 제외한 origin) / instance ID
GRAFANA_LOGS_QUERY_URL=
GRAFANA_LOGS_USER=
# 이 stack에만 metrics:read + logs:read. Alloy의 쓰기 토큰과 별개.
GRAFANA_READ_TOKEN=

# 기존 메인 앱 Axiom 로그 조회. 운영 환경 전용 dataset과 Query 권한 토큰.
AXIOM_QUERY_URL=https://api.axiom.co
AXIOM_QUERY_DATASET=
AXIOM_QUERY_TOKEN=

# 기존 Sentry 오류·업무 이벤트 조회. event:read + org:read, 대상 프로젝트 한정.
SENTRY_QUERY_URL=https://sentry.io
SENTRY_OBSERVABILITY_ORG=
SENTRY_OBSERVABILITY_PROJECTS=     # 숫자 project ID 권장, 쉼표 구분; 전체(-1) 금지
SENTRY_READ_TOKEN=
# 선택: admin 프로젝트의 서버 오류 수집 DSN (조회 토큰과 다름).
SENTRY_DSN=
