# /etc/alloy/observability.env (root:alloy 0640). Never add real tokens to git.
OBSERVABILITY_ENVIRONMENT=production
OBSERVABILITY_INSTANCE=bidit-lightsail-1
PM2_LOG_DIR=/home/ec2-user/.pm2/logs

# Grafana Cloud portal's Prometheus remote_write URL and instance ID.
GRAFANA_METRICS_WRITE_URL=https://prometheus-prod-REGION.grafana.net/api/prom/push
GRAFANA_METRICS_USER=
# Grafana Cloud portal's Loki push URL and instance ID.
GRAFANA_LOGS_WRITE_URL=https://logs-prod-REGION.grafana.net/loki/api/v1/push
GRAFANA_LOGS_USER=
# Access policy: ONLY metrics:write + logs:write on this stack.
GRAFANA_WRITE_TOKEN=

# Optional postgres.alloy; dedicated pg_monitor role, percent-encode password.
POSTGRES_MONITOR_DSN=
